---
// PARKED: not used anywhere right now. To bring it back, put <CatPerch /> at the right
// end of WeekList's "this week" heading, on a hairline (flex row, border-bottom).
// A cat sitting on that hairline, facing out. Drawn like the rest of the page: 1.5px muted strokes, no fills; the nose is the
// one touch of accent. Motion: a blink now and then, and an occasional tail flick.
// ~1 KB, no JS.
---

<svg class="cat" viewBox="0 0 32 34" width="25" height="27" aria-hidden="true" focusable="false">
	<!-- tail first: curls out from behind the right haunch, tip up -->
	<path class="tail" d="M23.6 31.8 C27.6 32.8 30.2 30.4 29.4 27.1 C29.1 25.9 28.2 25.3 27.4 25.7" />
	<!-- one outline, bell-shaped like a sitting cat: narrow shoulders, round haunches
	     out to each side, tucked in at the ground. Left haunch → head → right haunch. -->
	<path d="M9 33 C6.4 33 4.6 31 5.3 27.2 C6 23.2 8.2 19 10.2 16.6 C8.6 14.6 8.6 11.6 9.6 9.4 L10 3.8 L13 7.3 Q15 6.6 17 7.3 L20 3.8 L20.4 9.4 C21.4 11.6 21.4 14.6 19.8 16.6 C21.8 19 24 23.2 24.7 27.2 C25.4 31 23.6 33 21 33" />
	<!-- front paws: two small bumps at the base, not legs -->
	<path d="M11.4 33 Q12.6 31.2 13.8 33 M16.2 33 Q17.4 31.2 18.6 33" />
	<g class="eyes">
		<circle cx="12.7" cy="12.2" r="0.95" />
		<circle cx="17.3" cy="12.2" r="0.95" />
	</g>
	<path class="nose" d="M14.3 14.4 H15.7 L15 15.2 Z" />
</svg>

<style>
	.cat {
		display: block;
		flex-shrink: 0;
		overflow: visible;
		margin-bottom: -0.75px; /* sit on the hairline, not above it */
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.cat path {
		vector-effect: non-scaling-stroke; /* 1.5px like the checkboxes, at any size */
	}

	.eyes {
		fill: var(--muted);
		stroke: none;
		transform-box: fill-box;
		transform-origin: center;
		animation: blink 6.5s infinite;
	}
	.nose {
		fill: var(--accent);
		stroke: none;
	}

	/* The tail rests most of the time, then flicks once. Pivots at its base. */
	.tail {
		transform-box: view-box;
		transform-origin: 23.6px 31.8px;
		animation: flick 7s ease-in-out infinite;
	}

	/* Mostly open; a quick close-open near the end of each cycle. */
	@keyframes blink {
		0%,
		93%,
		100% {
			transform: scaleY(1);
		}
		95% {
			transform: scaleY(0.1);
		}
	}
	@keyframes flick {
		0%,
		70%,
		100% {
			transform: rotate(0deg);
		}
		76% {
			transform: rotate(-9deg);
		}
		82% {
			transform: rotate(3deg);
		}
		88% {
			transform: rotate(0deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.eyes,
		.tail {
			animation: none;
		}
	}
</style>
