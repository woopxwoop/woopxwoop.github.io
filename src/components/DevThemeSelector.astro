---
// Dev-only placeholder. Rendered only when import.meta.env.DEV (see Site.astro).
import { THEMES } from '../themes';
---

<label class="dev-theme">
	<span>theme</span>
	<select id="dev-theme-select">
		<option value="">auto (OS)</option>
		{Object.entries(THEMES).map(([id, t]) => <option value={id}>{t.label}</option>)}
	</select>
</label>

<script>
	import { getStoredTheme, isThemeId, setTheme } from '../themes';

	const select = document.getElementById('dev-theme-select') as HTMLSelectElement;
	select.value = getStoredTheme() ?? '';
	select.addEventListener('change', () => {
		setTheme(isThemeId(select.value) ? select.value : null);
	});
</script>

<style>
	.dev-theme {
		position: fixed;
		right: 12px;
		bottom: 12px;
		z-index: 10;
		display: flex;
		gap: 6px;
		align-items: center;
		padding: 6px 8px;
		border: 1px dashed var(--line);
		border-radius: 6px;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		color: var(--muted);
		font: 12px/1 ui-monospace, monospace;
	}
	select {
		font: inherit;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 2px 4px;
	}
</style>
