---
import { Image } from 'astro:assets';
import HobbyPage from '../../layouts/HobbyPage.astro';
import { authorOf, bookUrl, getHardcover, progressOf } from '../../data/hardcover';

const hc = await getHardcover();
const profileUrl = `https://hardcover.app/@${hc.username}`;

// Only show the goal if it's a book-count goal for the current period.
const now = new Date().toISOString().slice(0, 10);
const goal = hc.goals.find((g) => g.metric === 'book' && g.start_date <= now && now <= g.end_date);

const monthDay = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const shortDate = (d: string | null) => (d ? monthDay.format(new Date(`${d.slice(0, 10)}T00:00:00Z`)) : '');

/** 4.5 → "★★★★½" (Hardcover allows half stars). */
const stars = (r: number) => '★'.repeat(Math.floor(r)) + (r % 1 ? '½' : '');
---

<HobbyPage title="reading" blurb="mostly sci-fi and whatever my friends won't stop talking about.">
	{
		goal && (
			<section aria-label={`${new Date(goal.end_date).getUTCFullYear()} reading goal`}>
				<div class="goal-line">
					<span>{new Date(goal.end_date).getUTCFullYear()} goal</span>
					<span>
						{goal.progress} of {goal.goal} books
					</span>
				</div>
				<div class="bar" role="presentation">
					<i style={`width: ${Math.min(100, (goal.progress / goal.goal) * 100)}%`} />
				</div>
			</section>
		)
	}

	<h2>currently reading</h2>
	{
		hc.reading.length ? (
			<ul class="current">
				{hc.reading.map((e) => {
					const p = progressOf(e);
					const pagesRead = e.user_book_reads[0]?.progress_pages;
					const started = e.user_book_reads[0]?.started_at;
					return (
						<li>
							<a class="cover" href={bookUrl(e.book)} tabindex="-1" aria-hidden="true">
								{e.book.image && <Image src={e.book.image.url} alt="" width={120} height={180} fit="cover" />}
							</a>
							<div class="info">
								<a href={bookUrl(e.book)}>{e.book.title}</a>
								<span class="meta">
									{[authorOf(e.book), started && `started ${shortDate(started)}`].filter(Boolean).join(' · ')}
								</span>
								{p != null && (
									<>
										<div class="bar" role="presentation">
											<i style={`width: ${p * 100}%`} />
										</div>
										<span class="meta">
											p. {pagesRead} of {e.book.pages}
										</span>
									</>
								)}
							</div>
						</li>
					);
				})}
			</ul>
		) : (
			<p class="meta">between books right now.</p>
		)
	}

	<h2>recently finished</h2>
	<ul class="finished">
		{
			hc.finished.map((e) => (
				<li>
					<a href={bookUrl(e.book)}>{e.book.title}</a>
					<span class="meta stars" aria-label={e.rating ? `${e.rating} out of 5` : 'unrated'}>
						{e.rating ? stars(e.rating) : ''}
					</span>
					<span class="meta">{shortDate(e.last_read_date)}</span>
				</li>
			))
		}
	</ul>

	<p class="more"><a href={profileUrl}>everything on hardcover ↗</a></p>
</HobbyPage>

<style>
	a {
		text-decoration: none;
	}

	.meta {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.goal-line {
		display: flex;
		justify-content: space-between;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.bar {
		height: 4px;
		margin: 0.4rem 0;
		overflow: hidden;
		border-radius: 2px;
		background: var(--line);
	}
	.bar i {
		display: block;
		height: 100%;
		background: var(--accent);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.current li {
		display: flex;
		gap: 1rem;
	}
	.current li + li {
		margin-top: 1.25rem;
	}
	.cover {
		flex-shrink: 0;
		width: 4rem;
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border-radius: 3px;
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--line);
	}
	.cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.info {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		line-height: 1.4;
	}

	.finished li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto 3.5rem;
		gap: 1rem;
		align-items: baseline;
		padding: 0.55rem 0;
		border-top: 1px solid var(--line);
	}
	.finished li:last-child {
		border-bottom: 1px solid var(--line);
	}
	.finished a {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.finished .meta:last-child {
		text-align: right;
	}
	.stars {
		letter-spacing: 0.05em;
	}

	.more {
		margin-top: 1.5rem;
		font-size: 0.9rem;
	}
	.more a {
		color: var(--muted);
	}
	.more a:hover {
		color: var(--accent);
	}
</style>
