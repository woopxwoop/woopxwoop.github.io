---
import Site from '../layouts/Site.astro';
import { SITE_NAME } from '../consts';
import { getCanvas } from '../data/canvas';
import { readCanvasCourses } from '../data/canvas-courses';
import { courseTerms } from '../data/courses';

// getCanvas is memoized: shares the home page's fetch within a build.
const terms = courseTerms(readCanvasCourses(), await getCanvas());
// Code column as wide as the longest code ("MATH and CS 240"), shared by every term
// so all course names start at the same x.
const codeCh = Math.max(8, ...terms.flatMap((t) => t.courses.map((c) => c.code.length)));
---

<Site title={`courses · ${SITE_NAME}`} description="Courses I've taken at UW-Madison, by term.">
	<main style={`--code-col: ${codeCh + 1}ch`}>
		<h1>courses</h1>
		<p class="intro">what I've taken at UW-Madison</p>
		{terms.length === 0 && <p class="empty">no courses synced yet.</p>}
		{
			terms.map((t) => (
				<section aria-labelledby={`term-${t.label.replace(/\s+/g, '-')}`}>
					<h2 id={`term-${t.label.replace(/\s+/g, '-')}`}>
						{t.label}
						{t.current && <span class="now">in progress</span>}
					</h2>
					<ul class="courses">
						{t.courses.map((c) => (
							<li>
								<span class="code">{c.code}</span>
								<span class="name">
									{c.name}
									{c.section && <span class="section">sec {c.section}</span>}
								</span>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</main>
</Site>

<style>
	main {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 3.5rem var(--gutter) 5rem;
	}

	h1 {
		margin: 0 0 0.3em;
		font-size: clamp(2.2rem, 6vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.intro {
		margin: 0 0 2.5rem;
		color: var(--muted);
	}

	section + section {
		margin-top: 2.5rem;
	}
	/* Same small uppercase label as "this week" on the home page. */
	h2 {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.courses {
		max-width: var(--prose-width);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Code in a fixed-width column so every name starts at the same x. */
	.courses li {
		display: grid;
		grid-template-columns: var(--code-col) minmax(0, 1fr);
		column-gap: 1rem;
		padding: 0.55rem 0;
		border-top: 1px solid var(--line);
	}
	.courses li:last-child {
		border-bottom: 1px solid var(--line);
	}
	.code {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.section {
		margin-left: 0.6em;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.empty {
		color: var(--muted);
	}
	.now {
		margin-left: 0.8em;
		color: var(--accent);
	}
</style>
